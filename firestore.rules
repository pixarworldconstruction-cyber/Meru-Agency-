rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all denies all operations
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      // Allow read and write for any signed-in users so profiles are fully synchronized
      allow read, write: if isSignedIn();
    }

    // 2. Regional Branches Collection
    match /branches/{branchId} {
      // Allow read and write for signed-in users to manage fulfillment hubs
      allow read, write: if isSignedIn();
    }

    // 3. Products Catalogue Collection
    match /products/{productId} {
      // Allow read and write for signed-in users so stock and pricing are managed smoothly
      allow read, write: if isSignedIn();
    }

    // 4. Consignments & Deliveries Collection
    match /deliveries/{deliveryId} {
      // Allow read and write for signed-in users to place, prepare, ship, or cancel orders
      allow read, write: if isSignedIn();
    }

    // 5. Product-specific Discounts Collection
    match /discounts/{discountId} {
      // Allow read and write for signed-in users so discounts are securely fetched and set
      allow read, write: if isSignedIn();
    }

    // 6. Branch internal stock transfer demands
    match /transfers/{transferId} {
      allow read, write: if isSignedIn();
    }
  }
}
