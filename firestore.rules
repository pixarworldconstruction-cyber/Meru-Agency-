rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all denies all operations unless explicitly overridden below
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users Profile Collection
    match /users/{userId} {
      // Allow complete read, create, update, and delete operations for authenticated users
      allow read, create, update, delete: if isSignedIn();
    }

    // 2. Regional Branches Collection
    match /branches/{branchId} {
      // Allow standard branch hub access and deletions
      allow read, create, update, delete: if isSignedIn();
    }

    // 3. Products Catalogue Collection
    match /products/{productId} {
      // Allow sterile product entries and catalog inventory deletions
      allow read, create, update, delete: if isSignedIn();
    }

    // 4. Consignments & Deliveries Collection
    match /deliveries/{deliveryId} {
      // Allow complete delivery status updates, transfer orders, and tracking record deletions
      allow read, create, update, delete: if isSignedIn();
    }

    // 5. Product-specific Discounts Collection
    match /discounts/{discountId} {
      // Allow regional hub discounts to be added, adjusted, or deleted
      allow read, create, update, delete: if isSignedIn();
    }

    // 6. Branch internal stock transfer demands
    match /transfers/{transferId} {
      // Allow internal stock transfers and demand cancellations/deletions
      allow read, create, update, delete: if isSignedIn();
    }
  }
}
